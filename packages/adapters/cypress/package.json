{
  "name": "@optik/cypress",
  "version": "0.3.0",
  "description": "Visual snapshots with optik in Cypress tests",
  "license": "Apache-2.0",
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./support": {
      "types": "./dist/support.d.ts",
      "default": "./dist/support.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@optik/core": "workspace:*",
    "@optik/shared": "workspace:*"
  },
  "peerDependencies": {
    "cypress": ">=12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "cypress": "16.2.0",
    "typescript": "^5.4.0"
  }
}
