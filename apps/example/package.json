{
  "name": "@optik/example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5174",
    "test": "dotenv -e ../../.env vitest --run",
    "test:e2e": "playwright test",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build",
    "test:storybook": "storybook build --quiet && dotenv -e ../../.env -- optik storybook"
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@optik/cli": "workspace:*",
    "@optik/playwright": "workspace:*",
    "@optik/vitest": "workspace:*",
    "@playwright/test": "^1.40.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.12.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.3",
    "playwright": "^1.40.0",
    "storybook": "10.6.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.10",
    "vitest": "^5.0.3"
  }
}
