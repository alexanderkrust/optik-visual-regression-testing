generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CiProvider {
  github
  gitlab
  bitbucket
  bitbucket_server
  azure_devops
}

model Project {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  /// Branch whose baselines other branches fall back to when the git history
  /// doesn't lead to one (see SnapshotsService.findBaseline)
  defaultBranch String @default("main") @map("default_branch")
  /// Let tests fail on visual changes. Off when changes are reported as a
  /// commit status instead (CI stays green, the status blocks the merge).
  failTestsOnChanges Boolean @default(true) @map("fail_tests_on_changes")
  /// Commit statuses: the CI system's provider, repository (format depends
  /// on the provider), API URL (null = the provider's cloud service) and the
  /// token, encrypted (see SecretBox)
  ciProvider       CiProvider? @map("ci_provider")
  ciRepository     String?     @map("ci_repository")
  ciApiUrl         String?     @map("ci_api_url")
  ciTokenEncrypted String?     @map("ci_token_encrypted")
  createdAt DateTime   @default(now()) @map("created_at")
  runs      Run[]
  tokens    ApiToken[]
  members   ProjectMember[]
  invitations Invitation[]
  notificationChannels NotificationChannel[]
  snapshotSettings SnapshotSetting[]
  teams     TeamProject[]

  @@map("projects")
}

model ApiToken {
  id        String    @id @default(uuid())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String    @map("project_id")
  name      String
  /// SHA-256 of the token — the token itself is only shown once, on creation
  tokenHash   String  @unique @map("token_hash")
  /// First characters of the token, to recognise it in the UI
  tokenPrefix String  @map("token_prefix")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("api_tokens")
}

enum RunStatus {
  running
  complete
  approved
  rejected
}

model Run {
  id        String     @id @default(uuid())
  project   Project    @relation(fields: [projectId], references: [id])
  projectId String     @map("project_id")
  branch    String
  /// Test suite that produced the run (e.g. "vitest", "playwright"). Runs are
  /// merged and baselines are kept per suite. "default" for runs before suites.
  suite     String     @default("default")
  commitSha String     @map("commit_sha")
  /// The commit and its ancestors, newest first (sent by the adapters) —
  /// baselines come from runs on these commits
  ancestors String[]   @default([])
  status    RunStatus  @default(running)
  /// optik URL as the adapter reached it — for links in commit statuses
  serverUrl String?    @map("server_url")
  /// Pull request the run belongs to, where the CI system says so — Azure
  /// DevOps branch policies need statuses on the pull request
  pullRequest String?  @map("pull_request")
  createdAt DateTime   @default(now()) @map("created_at")
  // Consecutive runs without visual changes are merged into one run:
  // updatedAt is the last time it ran, runCount how often, lastCommitSha the latest commit.
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at")
  runCount      Int        @default(1) @map("run_count")
  lastCommitSha String?    @map("last_commit_sha")
  snapshots     Snapshot[]

  @@index([projectId, suite, branch, createdAt])
  @@map("runs")
}

enum SnapshotStatus {
  new // no baseline existed — becomes the baseline automatically
  unchanged // identical to the baseline
  pending // differs from the baseline, waiting for review
  approved // reviewed and accepted — becomes the new baseline
  rejected // reviewed and rejected — the previous baseline stays
}

model Snapshot {
  id         String         @id @default(uuid())
  run        Run            @relation(fields: [runId], references: [id])
  runId      String         @map("run_id")
  name       String
  status     SnapshotStatus @default(new)
  baseline   Snapshot?      @relation("baseline", fields: [baselineId], references: [id])
  baselineId String?        @map("baseline_id")
  children   Snapshot[]     @relation("baseline")
  diffScore  Float?         @map("diff_score")
  /// SHA-256 of the decoded pixels — finds identical, already approved images
  imageHash  String?        @map("image_hash")
  /// Set when the snapshot was accepted automatically because an identical
  /// image was already approved (e.g. on the branch a squash merge came from)
  autoApprovedFromId String? @map("auto_approved_from_id")
  /// Who accepted or rejected the change, and when
  reviewedBy   User?     @relation("reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  comments   SnapshotComment[]

  @@index([name, imageHash])
  @@map("snapshots")
}

/// admin: manages users, creates projects, has access to every project.
/// member: sees only the projects they are a member of.
enum UserRole {
  admin
  member
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  /// Null for accounts that only sign in with single sign-on
  password      String?        @map("password_hash")
  role          UserRole       @default(member)
  /// Set when the account is switched off (e.g. by SCIM): no sign-in, no API
  /// access, not counted as a reviewer; its reviews and comments stay
  deactivatedAt DateTime?      @map("deactivated_at")
  /// The identity provider's ID for the account (SCIM externalId)
  scimExternalId String?       @map("scim_external_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  refreshTokens RefreshToken[]
  memberships   ProjectMember[]
  reviews       Snapshot[]     @relation("reviewer")
  invitationsSent Invitation[] @relation("inviter")
  comments        SnapshotComment[]
  identities      UserIdentity[]
  teams           TeamMember[]
  ssoLoginCodes   SsoLoginCode[]

  @@map("users")
}

/// viewer: sees runs and images. reviewer: + accepts / rejects changes.
/// maintainer: + manages tokens, settings and members of the project.
enum ProjectRole {
  viewer
  reviewer
  maintainer
}

model ProjectMember {
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String      @map("project_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String      @map("user_id")
  role      ProjectRole
  createdAt DateTime    @default(now()) @map("created_at")

  @@id([projectId, userId])
  @@map("project_members")
}

/// A link that lets someone create an account (and optionally join a project).
model Invitation {
  id          String       @id @default(uuid())
  email       String
  /// SHA-256 of the token in the link
  tokenHash   String       @unique @map("token_hash")
  role        UserRole     @default(member)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String?      @map("project_id")
  projectRole ProjectRole? @map("project_role")
  invitedBy   User?        @relation("inviter", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById String?      @map("invited_by_id")
  expiresAt   DateTime     @map("expires_at")
  acceptedAt  DateTime?    @map("accepted_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("invitations")
}

model RefreshToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  /// SHA-256 of the refresh token — the token itself only lives in the session cookie
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

/// Instance-wide settings that are generated on first start (e.g. secrets)
model InstanceSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("instance_settings")
}

enum NotificationChannelType {
  slack
  teams
  webhook
  email
}

/// Where a project's notifications go (e.g. "changes to review").
model NotificationChannel {
  id        String                  @id @default(uuid())
  project   Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String                  @map("project_id")
  type      NotificationChannelType
  /// Webhook URL or email recipients — encrypted (webhook URLs are credentials)
  targetEncrypted String            @map("target_encrypted")
  /// Short, non-secret description shown in the UI (e.g. "hooks.slack.com/…/Xb3")
  label     String
  /// Generic webhooks: HMAC secret for the X-Optik-Signature header, encrypted
  secretEncrypted String?           @map("secret_encrypted")
  events    String[]
  createdAt DateTime                @default(now()) @map("created_at")

  @@map("notification_channels")
}

/// Review settings of a snapshot name in a project and suite, applied to every
/// comparison: areas to ignore and how many pixels may change.
model SnapshotSetting {
  id            String   @id @default(uuid())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String   @map("project_id")
  suite         String
  name          String
  /// [{ x, y, width, height }] in image pixels
  ignoreRegions Json     @default("[]") @map("ignore_regions")
  /// Share of pixels (0–1) that may change before a snapshot counts as changed
  threshold     Float    @default(0)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([projectId, suite, name])
  @@map("snapshot_settings")
}

model SnapshotComment {
  id         String   @id @default(uuid())
  snapshot   Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  snapshotId String   @map("snapshot_id")
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId   String?  @map("author_id")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([snapshotId])
  @@map("snapshot_comments")
}

/// Enterprise audit log (src/ee/audit). Rows are never changed or removed —
/// a trigger refuses it — and each row's hash covers the previous row's, so
/// edits made directly in the database are detected (GET /audit-events/verify).
/// No foreign keys: events outlive the users and projects they mention.
model AuditEvent {
  seq         BigInt   @id @default(autoincrement())
  createdAt   DateTime @map("created_at")
  action      String
  actorType   String   @map("actor_type")
  actorId     String?  @map("actor_id")
  actorLabel  String?  @map("actor_label")
  projectId   String?  @map("project_id")
  projectSlug String?  @map("project_slug")
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  targetLabel String?  @map("target_label")
  details     Json     @default("{}")
  ip          String?
  userAgent   String?  @map("user_agent")
  prevHash    String   @map("prev_hash")
  hash        String

  @@index([createdAt])
  @@index([action])
  @@index([projectId])
  @@index([actorId])
  @@map("audit_events")
}

enum IdpProtocol {
  oidc
  saml
}

/// Single sign-on with an OpenID Connect or SAML 2.0 provider (src/ee/sso).
model IdentityProvider {
  id                    String   @id @default(uuid())
  name                  String
  protocol              IdpProtocol @default(oidc)
  /// OIDC: issuer URL; its /.well-known/openid-configuration describes the
  /// rest. SAML: the provider's entity ID.
  issuer                String
  /// OIDC only
  clientId              String?  @map("client_id")
  clientSecretEncrypted String?  @map("client_secret_encrypted")
  scopes                String   @default("openid email profile")
  /// SAML: where the browser signs in (HTTP-Redirect binding)
  samlEntryPoint        String?  @map("saml_entry_point")
  /// SAML: the provider's signing certificate (PEM)
  samlCertificate       String?  @map("saml_certificate")
  /// SAML: attribute with the e-mail address (else the NameID)
  emailAttribute        String   @default("email") @map("email_attribute")
  /// Claim with the user's groups, for role mapping
  groupsClaim           String   @default("groups") @map("groups_claim")
  /// [{ group, project: slug | null, role }] — see SsoRoleMapping
  roleMappings          Json     @default("[]") @map("role_mappings")
  /// Only these e-mail domains may sign in; empty = any
  allowedDomains        String[] @default([]) @map("allowed_domains")
  /// Create an account on the first sign-in (otherwise only invited users)
  createUsers           Boolean  @default(true) @map("create_users")
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at")
  identities            UserIdentity[]

  @@map("identity_providers")
}

/// A user's account at an identity provider, by its stable subject ID.
model UserIdentity {
  id          String           @id @default(uuid())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String           @map("user_id")
  provider    IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId  String           @map("provider_id")
  subject     String
  email       String
  lastLoginAt DateTime         @default(now()) @map("last_login_at")

  @@unique([providerId, subject])
  @@map("user_identities")
}

/// One-time code that hands a finished single sign-on to the web UI (60 s).
model SsoLoginCode {
  codeHash  String   @id @map("code_hash")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")

  @@map("sso_login_codes")
}

/// A group of users with roles in projects (Enterprise; src/ee/teams). A
/// member's role in a project is the highest of their own and their teams'.
model Team {
  id          String        @id @default(uuid())
  name        String        @unique
  description String?
  /// The identity provider's ID for the group (SCIM externalId)
  scimExternalId String?    @map("scim_external_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  members     TeamMember[]
  projects    TeamProject[]

  @@map("teams")
}

model TeamMember {
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String   @map("team_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model TeamProject {
  team      Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String      @map("team_id")
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String      @map("project_id")
  role      ProjectRole

  @@id([teamId, projectId])
  @@index([projectId])
  @@map("team_projects")
}

/// SAML authentication requests in flight — a response must answer one
/// (InResponseTo). The ID doubles as RelayState, which may only be 80 bytes.
model SamlRequest {
  id        String   @id
  returnTo  String   @default("/") @map("return_to")
  expiresAt DateTime @map("expires_at")

  @@map("saml_requests")
}
