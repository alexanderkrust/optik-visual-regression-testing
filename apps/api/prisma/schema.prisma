generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CiProvider {
  github
  gitlab
  bitbucket
  bitbucket_server
  azure_devops
}

model Project {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  /// Branch whose baselines other branches fall back to when the git history
  /// doesn't lead to one (see SnapshotsService.findBaseline)
  defaultBranch String @default("main") @map("default_branch")
  /// Let tests fail on visual changes. Off when changes are reported as a
  /// commit status instead (CI stays green, the status blocks the merge).
  failTestsOnChanges Boolean @default(true) @map("fail_tests_on_changes")
  /// Commit statuses: the CI system's provider, repository (format depends
  /// on the provider), API URL (null = the provider's cloud service) and the
  /// token, encrypted (see SecretBox)
  ciProvider       CiProvider? @map("ci_provider")
  ciRepository     String?     @map("ci_repository")
  ciApiUrl         String?     @map("ci_api_url")
  ciTokenEncrypted String?     @map("ci_token_encrypted")
  createdAt DateTime   @default(now()) @map("created_at")
  runs      Run[]
  tokens    ApiToken[]
  members   ProjectMember[]
  invitations Invitation[]
  notificationChannels NotificationChannel[]
  snapshotSettings SnapshotSetting[]

  @@map("projects")
}

model ApiToken {
  id        String    @id @default(uuid())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String    @map("project_id")
  name      String
  /// SHA-256 of the token — the token itself is only shown once, on creation
  tokenHash   String  @unique @map("token_hash")
  /// First characters of the token, to recognise it in the UI
  tokenPrefix String  @map("token_prefix")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("api_tokens")
}

enum RunStatus {
  running
  complete
  approved
  rejected
}

model Run {
  id        String     @id @default(uuid())
  project   Project    @relation(fields: [projectId], references: [id])
  projectId String     @map("project_id")
  branch    String
  /// Test suite that produced the run (e.g. "vitest", "playwright"). Runs are
  /// merged and baselines are kept per suite. "default" for runs before suites.
  suite     String     @default("default")
  commitSha String     @map("commit_sha")
  /// The commit and its ancestors, newest first (sent by the adapters) —
  /// baselines come from runs on these commits
  ancestors String[]   @default([])
  status    RunStatus  @default(running)
  /// optik URL as the adapter reached it — for links in commit statuses
  serverUrl String?    @map("server_url")
  /// Pull request the run belongs to, where the CI system says so — Azure
  /// DevOps branch policies need statuses on the pull request
  pullRequest String?  @map("pull_request")
  createdAt DateTime   @default(now()) @map("created_at")
  // Consecutive runs without visual changes are merged into one run:
  // updatedAt is the last time it ran, runCount how often, lastCommitSha the latest commit.
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at")
  runCount      Int        @default(1) @map("run_count")
  lastCommitSha String?    @map("last_commit_sha")
  snapshots     Snapshot[]

  @@index([projectId, suite, branch, createdAt])
  @@map("runs")
}

enum SnapshotStatus {
  new // no baseline existed — becomes the baseline automatically
  unchanged // identical to the baseline
  pending // differs from the baseline, waiting for review
  approved // reviewed and accepted — becomes the new baseline
  rejected // reviewed and rejected — the previous baseline stays
}

model Snapshot {
  id         String         @id @default(uuid())
  run        Run            @relation(fields: [runId], references: [id])
  runId      String         @map("run_id")
  name       String
  status     SnapshotStatus @default(new)
  baseline   Snapshot?      @relation("baseline", fields: [baselineId], references: [id])
  baselineId String?        @map("baseline_id")
  children   Snapshot[]     @relation("baseline")
  diffScore  Float?         @map("diff_score")
  /// SHA-256 of the decoded pixels — finds identical, already approved images
  imageHash  String?        @map("image_hash")
  /// Set when the snapshot was accepted automatically because an identical
  /// image was already approved (e.g. on the branch a squash merge came from)
  autoApprovedFromId String? @map("auto_approved_from_id")
  /// Who accepted or rejected the change, and when
  reviewedBy   User?     @relation("reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  comments   SnapshotComment[]

  @@index([name, imageHash])
  @@map("snapshots")
}

/// admin: manages users, creates projects, has access to every project.
/// member: sees only the projects they are a member of.
enum UserRole {
  admin
  member
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String         @map("password_hash")
  role          UserRole       @default(member)
  createdAt     DateTime       @default(now()) @map("created_at")
  refreshTokens RefreshToken[]
  memberships   ProjectMember[]
  reviews       Snapshot[]     @relation("reviewer")
  invitationsSent Invitation[] @relation("inviter")
  comments        SnapshotComment[]

  @@map("users")
}

/// viewer: sees runs and images. reviewer: + accepts / rejects changes.
/// maintainer: + manages tokens, settings and members of the project.
enum ProjectRole {
  viewer
  reviewer
  maintainer
}

model ProjectMember {
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String      @map("project_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String      @map("user_id")
  role      ProjectRole
  createdAt DateTime    @default(now()) @map("created_at")

  @@id([projectId, userId])
  @@map("project_members")
}

/// A link that lets someone create an account (and optionally join a project).
model Invitation {
  id          String       @id @default(uuid())
  email       String
  /// SHA-256 of the token in the link
  tokenHash   String       @unique @map("token_hash")
  role        UserRole     @default(member)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String?      @map("project_id")
  projectRole ProjectRole? @map("project_role")
  invitedBy   User?        @relation("inviter", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById String?      @map("invited_by_id")
  expiresAt   DateTime     @map("expires_at")
  acceptedAt  DateTime?    @map("accepted_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("invitations")
}

model RefreshToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  /// SHA-256 of the refresh token — the token itself only lives in the session cookie
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

/// Instance-wide settings that are generated on first start (e.g. secrets)
model InstanceSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("instance_settings")
}

enum NotificationChannelType {
  slack
  teams
  webhook
  email
}

/// Where a project's notifications go (e.g. "changes to review").
model NotificationChannel {
  id        String                  @id @default(uuid())
  project   Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String                  @map("project_id")
  type      NotificationChannelType
  /// Webhook URL or email recipients — encrypted (webhook URLs are credentials)
  targetEncrypted String            @map("target_encrypted")
  /// Short, non-secret description shown in the UI (e.g. "hooks.slack.com/…/Xb3")
  label     String
  /// Generic webhooks: HMAC secret for the X-Optik-Signature header, encrypted
  secretEncrypted String?           @map("secret_encrypted")
  events    String[]
  createdAt DateTime                @default(now()) @map("created_at")

  @@map("notification_channels")
}

/// Review settings of a snapshot name in a project and suite, applied to every
/// comparison: areas to ignore and how many pixels may change.
model SnapshotSetting {
  id            String   @id @default(uuid())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String   @map("project_id")
  suite         String
  name          String
  /// [{ x, y, width, height }] in image pixels
  ignoreRegions Json     @default("[]") @map("ignore_regions")
  /// Share of pixels (0–1) that may change before a snapshot counts as changed
  threshold     Float    @default(0)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([projectId, suite, name])
  @@map("snapshot_settings")
}

model SnapshotComment {
  id         String   @id @default(uuid())
  snapshot   Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  snapshotId String   @map("snapshot_id")
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId   String?  @map("author_id")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([snapshotId])
  @@map("snapshot_comments")
}
