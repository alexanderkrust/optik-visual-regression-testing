FROM node:20-alpine
WORKDIR /app
RUN npm install -g pnpm@9

# ── 1. Install dependencies (cached layer) ───────────────────────────────────
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
# Copy full package sources so pnpm workspace links resolve correctly
COPY packages/ ./packages/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN pnpm install

# ── 2. Build @optik/core so dist/ exists for runtime resolution ──────────────
RUN pnpm --filter @optik/core build

# ── 3. Copy API config files (source is mounted via docker-compose volumes) ──
COPY turbo.json ./
COPY apps/api/nest-cli.json apps/api/tsconfig.json apps/api/prisma.config.ts apps/api/

# Polling required for inotify-less bind mounts (macOS / Windows Docker)
ENV CHOKIDAR_USEPOLLING=true

# prisma generate + migrate run at container START (not at build time) because
# they need a live database — postgres is not available during docker build.
CMD ["sh", "-c", "\
  pnpm --filter @optik/api exec prisma generate && \
  pnpm --filter @optik/api exec prisma migrate dev --name init && \
  { pnpm --filter @optik/core dev & } && \
  pnpm --filter @optik/api dev \
  "]
