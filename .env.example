# ─── Database ────────────────────────────────────────────────────────────────

DATABASE_URL="postgresql://optik:optik@localhost:5432/optik"

# ─── API (apps/api) ───────────────────────────────────────────────────────────

# Port of the API in development (the web UI runs on Vite :5173 and proxies /api).
# In production optik serves UI and API together on PORT (default 3000).
PORT=3001

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Initial admin user — created automatically on first startup if no user exists yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ─── Object storage (S3-compatible) ──────────────────────────────────────────
# Screenshots and diffs are stored here. The dev stack runs SeaweedFS on :8333
# (credentials in docker/seaweedfs/s3.json). The bucket is created on startup.

S3_ENDPOINT="http://localhost:8333"
S3_REGION="us-east-1"
S3_BUCKET="optik-snapshots"
S3_ACCESS_KEY_ID="optik"
S3_SECRET_ACCESS_KEY="optik-secret"
# Set to "false" for AWS S3 virtual-hosted-style URLs
S3_FORCE_PATH_STYLE="true"

# ─── Web (apps/web) ───────────────────────────────────────────────────────────

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# ─── Adapters (@optik/vitest, @optik/playwright) ─────────────────────────────

# URL of the optik web UI — adapters call <url>/api and link review pages from it
OPTIK_SERVER_URL="http://localhost:5173"
CI_BRANCH="main"
CI_COMMIT="unknown"

# ─── Example app (apps/example) ──────────────────────────────────────────────

# Project-scoped API token — create one in the Optik UI under Access Tokens
OPTIK_TOKEN=optik_your_token_here
